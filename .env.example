# Plantilla de variables de entorno. Cópiala como .env.local y cambia los valores:
#   cp .env.example .env.local
# .env.local nunca se sube a Git. Las variables se validan con Zod al arrancar (src/composition/env.ts).

# --- PostgreSQL + pgvector en Docker (docker-compose.yml) ---
# Usuario, contraseña y nombre con los que se crea la base de datos la primera vez que se levanta.
POSTGRES_USER=memnon
POSTGRES_PASSWORD=cambia-esta-clave
POSTGRES_DB=memnon

# Conexión que usa la aplicación. Debe coincidir con los valores de arriba.
DATABASE_URL=postgresql://memnon:cambia-esta-clave@localhost:5432/memnon
