# Plantilla de variables de entorno. Cópiala como .env.local y cambia los valores:
#   cp .env.example .env.local
# .env.local nunca se sube a Git. Las variables se validan con Zod al arrancar (src/composition/env.ts).

# --- PostgreSQL + pgvector en Docker (docker-compose.yml) ---
# Usuario, contraseña y nombre con los que se crea la base de datos la primera vez que se levanta.
POSTGRES_USER=memnon
POSTGRES_PASSWORD=cambia-esta-clave
POSTGRES_DB=memnon

# Conexión que usa la aplicación. Debe coincidir con los valores de arriba.
DATABASE_URL=postgresql://memnon:cambia-esta-clave@localhost:5432/memnon

# --- Autenticación (Better Auth) ---
# Firma las cookies de sesión. Al menos 32 caracteres aleatorios: genera uno con  npm run auth:secret
# El valor de esta plantilla es demasiado corto a propósito: la aplicación no arranca hasta que pongas uno real.
BETTER_AUTH_SECRET=pon-aqui-un-secreto-generado
# Dirección de la aplicación (en producción, la URL pública con https).
BETTER_AUTH_URL=http://localhost:3000

# --- Modelo de lenguaje del RAG ---
# Sin estas variables se usa Ollama en local (http://127.0.0.1:11434/v1 con qwen2.5:7b).
# Al desplegar, apuntan a cualquier servidor con protocolo OpenAI (Groq, Gemini...) y su clave.
# LLM_BASE_URL=http://127.0.0.1:11434/v1
# LLM_MODEL=qwen2.5:7b
# LLM_API_KEY=
